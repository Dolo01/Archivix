// Schéma de base de données Archivix — PostgreSQL (hébergé sur Neon).
// Documentation : https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // connexion "poolée" (application)
  directUrl = env("DATABASE_URL_UNPOOLED") // connexion directe (migrations Prisma)
}

model Tenant {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  sector                String?
  logoUrl               String?
  plan                  String    @default("essai") // essai | starter | pro | business | entreprise
  storageQuotaMb        Float     @default(5000)
  storageUsedMb         Float     @default(0)
  isActive              Boolean   @default(true)
  subscriptionExpiresAt DateTime?
  // Stockage des documents : "archivix" (Supabase / disque) ou "google_drive" (Drive de l'organisation)
  storageProvider        String    @default("archivix")
  googleDriveEmail       String?
  googleDriveRefreshToken String?  // chiffré (AES-256-GCM), jamais renvoyé au navigateur
  googleDriveFolderId    String?
  googleDriveConnectedAt DateTime?
  expiryReminderSentAt   DateTime? // dernier rappel envoyé pour la fin d'essai / d'abonnement
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users                User[]
  departments          Department[]
  folders              Folder[]
  documents            Document[]
  categories           Category[]
  messages             Message[]
  subscriptionRequests SubscriptionRequest[]
  notifications        Notification[]
}

model User {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  fullName     String
  email        String
  passwordHash String
  role         String      @default("lecteur")
  isActive     Boolean     @default(true)
  mustChangePassword Boolean @default(false) // mot de passe temporaire à remplacer à la première connexion
  passwordChangedAt  DateTime? // les sessions ouvertes avant cette date sont invalidées
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  documents     Document[]
  messages      Message[]
  notifications Notification[]

  @@unique([tenantId, email])
}

model SuperAdmin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  decisions SubscriptionRequest[]
}

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdById String
  googleDriveFolderId String? // sous-dossier du département dans le Drive de l'organisation
  createdAt   DateTime @default(now())

  members   User[]
  folders   Folder[]
  documents Document[]

  @@unique([tenantId, name])
}

model Folder {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  description  String?
  sharedWithDepartments String @default("[]")
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents Document[]

  @@unique([departmentId, name])
}

model Category {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  color    String  @default("#B8860B")
  parentId String?

  documents Document[]
}

model Document {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  folderId     String?
  folder       Folder?     @relation(fields: [folderId], references: [id])
  title        String
  reference    String?
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  tags         String      @default("[]")
  sharedWithDepartments String @default("[]")
  fileName     String
  fileUrl      String
  storageProvider String     @default("archivix") // où le fichier est réellement stocké
  storageKey   String?     // identifiant du fichier dans Google Drive
  mimeType     String
  sizeKb       Float
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  status       String      @default("archive")
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages Message[]
}

model SubscriptionRequest {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  plan             String      // starter | pro | business
  dureeMois        Int         @default(12)
  montant          Float
  moyenPaiement    String
  numeroExpediteur String
  reference        String
  captureUrl       String?
  status           String      @default("en_attente")
  motifRefus       String?
  decidedById      String?
  decidedBy        SuperAdmin? @relation(fields: [decidedById], references: [id])
  decidedAt        DateTime?
  createdAt        DateTime    @default(now())
}

model Message {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Journal d'activité : qui a fait quoi, sur quel document, et quand.
// Volontairement sans clé étrangère (hors organisation) : l'historique doit survivre
// à la suppression d'un document, d'un dossier ou d'un membre.
model ActivityLog {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?
  userName       String?
  action         String   // archivage | consultation | modification | partage | suppression
  documentId     String?
  documentTitle  String?
  departmentId   String?
  departmentName String?
  details        String?  // texte libre lisible (ex. « Statut : Définitif »)
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([documentId])
}

// Appareils (navigateur d'ordinateur, téléphone, tablette) abonnés aux notifications Web Push.
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Liens à usage unique pour choisir ou réinitialiser un mot de passe (invitation, mot de passe oublié).
// Seule l'empreinte SHA-256 du jeton est stockée.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String    // reinitialisation | invitation
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
