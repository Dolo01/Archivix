PORT=5000
NODE_ENV=development

# Base de données PostgreSQL (Supabase - connection pooling)
# Ne mettez JAMAIS de vraies valeurs dans ce fichier : il est publié sur GitHub.
# Copiez-le en ".env" (ignoré par Git) et renseignez-y vos valeurs réelles.
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@HOTE:5432/postgres"

# Authentification — générez une valeur longue et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a_remplacer_par_une_valeur_aleatoire
JWT_EXPIRES_IN=7d

# Stockage des fichiers (par défaut). Sans SUPABASE_SERVICE_ROLE_KEY,
# le stockage retombe sur le disque local (dossier "uploads/").
UPLOAD_DIR=uploads
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archivix

# Stockage dans le Google Drive de chaque organisation (optionnel)
# Voir la section "Google Drive" de DEPLOYMENT.md pour obtenir ces valeurs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être identique à l'URI de redirection déclarée dans Google Cloud :
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback
# Clé de chiffrement des jetons Google (64 caractères hexadécimaux) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Coordonnées de paiement affichées aux entreprises pour le dépôt manuel Wave / Orange Money
WAVE_NUMBER="+223 XX XX XX XX"
ORANGE_MONEY_NUMBER="+223 XX XX XX XX"
PAYMENT_BENEFICIARY_NAME="Nom du bénéficiaire"
PAYMENT_BENEFICIARY_EMAIL="contact@exemple.com"

FRONTEND_URL=http://localhost:5173
