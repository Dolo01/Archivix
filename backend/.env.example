PORT=5000
NODE_ENV=development

# Ne mettez JAMAIS de vraies valeurs dans ce fichier : il est publié sur GitHub.
# Copiez-le en ".env" (ignoré par Git) et renseignez-y vos valeurs réelles.

# Base de données PostgreSQL (Neon). Deux adresses, copiées depuis Neon → Connect :
#  - DATABASE_URL : connexion "poolée" (nom d'hôte avec "-pooler"), pour l'application
#  - DATABASE_URL_UNPOOLED : connexion directe (sans "-pooler"), pour les migrations Prisma
# En local avec un PostgreSQL classique, mettez la même adresse dans les deux.
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@ep-xxxx-pooler.REGION.aws.neon.tech/archivix?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://USER:MOT_DE_PASSE@ep-xxxx.REGION.aws.neon.tech/archivix?sslmode=require&connect_timeout=15"

# Authentification — générez une valeur longue et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a_remplacer_par_une_valeur_aleatoire
JWT_EXPIRES_IN=7d

# Stockage des fichiers : Neon Object Storage (compatible S3, bucket privé).
# Valeurs dans Neon → Connect → onglet Storage. Sans ces variables, Archivix utilise
# Supabase Storage s'il est configuré ci-dessous, sinon le disque local (dossier UPLOAD_DIR).
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.REGION.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=archivix
UPLOAD_DIR=uploads

# (Ancien) Supabase Storage — utilisé seulement si les variables AWS_* ci-dessus sont vides.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archivix

# Stockage dans le Google Drive de chaque organisation (optionnel)
# Voir la section "Google Drive" de DEPLOYMENT.md pour obtenir ces valeurs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être identique à l'URI de redirection déclarée dans Google Cloud :
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback
# Clé de chiffrement des jetons Google (64 caractères hexadécimaux) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Coordonnées de paiement affichées aux entreprises pour le dépôt manuel Wave / Orange Money
WAVE_NUMBER="+223 XX XX XX XX"
ORANGE_MONEY_NUMBER="+223 XX XX XX XX"
PAYMENT_BENEFICIARY_NAME="Nom du bénéficiaire"
PAYMENT_BENEFICIARY_EMAIL="contact@exemple.com"

FRONTEND_URL=http://localhost:5173
